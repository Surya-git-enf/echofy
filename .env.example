# Copy to .env and fill in. Never commit .env.

# Always required
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STEMSPLIT_API_KEY=

# Default voice engine (Gnani Vachana)
GNANI_API_KEY=

# Optional engines
FISH_AUDIO_API_KEY=
FISH_VOICE_POOL=
SARVAM_API_KEY=
ECHOFY_VOICE_SERVICE_URL=

# Optional settings
ALLOWED_ORIGINS=*
DUB_ENGINE=gnani
STEM_CACHE_DIR=.cache/stems
